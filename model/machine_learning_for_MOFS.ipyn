        "from sklearn.model_selection import RandomizedSearchCV\n",
        "from sklearn.ensemble import RandomForestRegressor # Also ensure RandomForestRegressor is imported if not already\n"
      ],
      "metadata": {
        "id": "nVWlTxLEhptI"
