&CONTROL
  calculation = 'relax',
  outdir = './out/',
  prefix = 'FeCO',
  pseudo_dir = './pseudo/',
  nstep= 10000,
  restart_mode = 'from_scatch',
  max_seconds = 171000,
/
&SYSTEM
  degauss = 0.03,
  ecutrho = 120,
  ecutwfc = 15,
  ibrav = 0,
  nat = 30,
  ntyp = 4,
  occupations = 'smearing',
  smearing = 'gaussian',
  !nbnd = 300,
  vdw_corr= 'grimme-d3',
/
&ELECTRONS
  conv_thr =   1.0000000000d-06,
  electron_maxstep = 1000000,
  mixing_beta = 0.2,
/
&IONS
/
